# Copy to .env or set in your shell. Every key is optional: a stage without its key is skipped.
# Only the names in this file are read (launcher.ENV_NAMES); anything else is ignored and named at startup.
# Some settings belong to another and count only when that one is set too:
#   CI_YOUTUBE_RIGHTS needs YOUTUBE_API_KEY;  CI_BRAVE_USD_PER_REQUEST needs BRAVE_API_KEY;
#   CI_APIFY_* need APIFY_TOKEN (CI_BROKER_RIGHTS always counts: it can only narrow);  CI_AI_URL and CI_AI_MODEL need each other;  CI_AI_KEY needs CI_AI_URL.
# "Set too" means in this same file: a setting here never leans on a key that is only set in Windows.
BRAVE_API_KEY=
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
# After confirming the YouTube derived-metrics policy covers you: store,ai,derive
CI_YOUTUBE_RIGHTS=store
# CI_DB=data/creator_intel.db
# CI_MODEL=claude-opus-5-5
# Discord or Slack incoming webhook for the weekly alert (https only; a secret)
CI_WEBHOOK_URL=
# Password the dashboard asks for before showing anything (empty = no login). Plain text, like the keys.
CI_PASSWORD=
# Your Brave plan price per request, for the cost report
# CI_BRAVE_USD_PER_REQUEST=0
# Apify token for scraping videos through the data broker (each scrape costs credits)
APIFY_TOKEN=
# Narrow what scraped data may be used for, e.g. store (no AI, no scoring)
# CI_BROKER_RIGHTS=store,ai,derive
# Use another AI model instead of Claude: any server that speaks the OpenAI chat-completions protocol,
# e.g. Ollama on this computer. Plain http is accepted for this computer only; elsewhere it must be https.
# CI_AI_URL=http://127.0.0.1:11434/v1
# CI_AI_MODEL=llama3.1
# CI_AI_KEY=
